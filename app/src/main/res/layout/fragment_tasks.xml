<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_horizontal_padding"
    android:paddingTop="@dimen/space_20"
    android:paddingEnd="@dimen/page_horizontal_padding"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tasks"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="Track deliverables and keep your team aligned"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_empty_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:background="@drawable/bg_card_soft"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:text="No tasks yet.\nCreate your first task to start tracking work."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_12" />

    <Button
        android:id="@+id/btn_add_task"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_button_primary"
        android:text="Add Task"
        android:textAllCaps="false"
        android:textColor="@color/text_on_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>