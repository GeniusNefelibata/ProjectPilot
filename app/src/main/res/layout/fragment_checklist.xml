<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/space_20"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="@dimen/space_32">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checklist"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="Track final deliverables before submission"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submission Readiness"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_checklist_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="0 of 6 completed"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="Keep this checklist updated so your dashboard stays accurate."
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deliverables"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="Mark each item once it is ready."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_report_completed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="Report completed"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:buttonTint="@color/accent_primary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_source_code_ready"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="Source code ready"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:buttonTint="@color/accent_primary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_readme_ready"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="README ready"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:buttonTint="@color/accent_primary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_slides_ready"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="Slides ready"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:buttonTint="@color/accent_primary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_demo_ready"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="Demo ready"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:buttonTint="@color/accent_primary" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_video_ready"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:text="Video ready"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                app:buttonTint="@color/accent_primary" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>